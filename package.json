{
  "name": "tonal-oklch",
  "version": "0.2.0",
  "description": "A hybrid color space pairing OKLCh perceptual hue & chroma with CIE L* guaranteed WCAG contrast. Colors at the same tone always have identical contrast ratios.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "viz": "npm run build && node scripts/viz.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "color-space",
    "color-science",
    "color",
    "perceptual",
    "oklch",
    "hct",
    "tonal",
    "wcag",
    "accessibility",
    "a11y",
    "contrast-ratio",
    "gamut-mapping",
    "design-systems",
    "color-systems"
  ],
  "license": "MIT",
  "homepage": "https://www.tonal-oklch.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SashimiEthan/tonal-oklch.git"
  },
  "author": "",
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.0"
  }
}
